{
  "name": "pickleup-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "predev": "npm run build:assets",
    "dev": "wrangler dev",
    "deploy": "npm run build:assets && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "check": "npm run build:assets && wrangler deploy --dry-run --outdir .wrangler-dist"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
