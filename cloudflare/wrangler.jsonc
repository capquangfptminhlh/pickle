{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickleup-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://pickleup.vn,https://www.pickleup.vn,https://capquangfptminhlh.github.io,http://localhost:8080,http://127.0.0.1:8080",
    "PUBLIC_APP_URL": "https://pickleup.vn"
  },
  "routes": [
    {
      "pattern": "api.pickleup.vn",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickleup-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TournamentRoom"
      }
    ]
  },
  "exports": {
    "TournamentRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
